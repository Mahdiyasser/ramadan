  <script>
    /* ── Starfield ── */
    (() => {
      const container = document.getElementById('stars-container');
      for (let i = 0; i < 60; i++) {
        const s = document.createElement('div');
        s.className = 'star';
        s.style.cssText = `
          top:${Math.random()*100}%;
          left:${Math.random()*100}%;
          --d:${(2 + Math.random()*4).toFixed(1)}s;
          --o:${(0.2 + Math.random()*0.6).toFixed(2)};
          animation-delay:${(Math.random()*4).toFixed(1)}s;
          width:${Math.random()>0.7?3:2}px;
          height:${Math.random()>0.7?3:2}px;
        `;
        container.appendChild(s);
      }
    })();

    /* ── PWA Install logic ── */
    (() => {
      const btn           = document.getElementById('install-btn');
      const statusMsg     = document.getElementById('status-msg');
      const noticeInstalled   = document.getElementById('notice-installed');
      const noticeUnsupported = document.getElementById('notice-unsupported');

      let deferredPrompt = null;

      function showStatus(text, type = '') {
        statusMsg.textContent = text;
        statusMsg.className = 'status-msg ' + type;
      }

      function hideButton() {
        btn.style.display = 'none';
        statusMsg.style.display = 'none';
      }

      function showNotice(which) {
        hideButton();
        which.style.display = 'flex';
      }

      // Already running as installed PWA
      if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true) {
        showNotice(noticeInstalled);
        return;
      }

      // Capture the browser's install prompt
      window.addEventListener('beforeinstallprompt', e => {
        e.preventDefault();
        deferredPrompt = e;
        btn.disabled = false;
      });

      // If the event never fires after load, browser doesn't support it
      window.addEventListener('load', () => {
        setTimeout(() => {
          if (!deferredPrompt) {
            showNotice(noticeUnsupported);
          }
        }, 800);
      });

      // Button click → trigger native prompt
      btn.addEventListener('click', async () => {
        if (!deferredPrompt) return;

        btn.classList.add('loading');
        btn.querySelector('.btn-text').textContent = 'جارٍ التثبيت…';
        showStatus('');

        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        deferredPrompt = null;

        btn.classList.remove('loading');

        if (outcome === 'accepted') {
          showStatus('🎉 تم التثبيت بنجاح! يمكنك فتح التطبيق من شاشتك الرئيسية', 'success');
          btn.querySelector('.btn-text').textContent = 'تم التثبيت ✓';
          btn.disabled = true;
        } else {
          btn.querySelector('.btn-text').textContent = 'ثبّت التطبيق';
          showStatus('يمكنك التثبيت في أي وقت تشاء', '');
        }
      });

      // Also handle if app gets installed another way (e.g. browser menu)
      window.addEventListener('appinstalled', () => {
        showNotice(noticeInstalled);
      });
    })();
  </script>

</body>
